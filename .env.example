# Copia este archivo como .env y cambia las claves. El .env real NO se sube a Git.

# --- Base de datos ---
DB_NAME=ferreteria_los_maestros
DB_USER=ferreteria_user
DB_PASSWORD=cambia_esta_clave
DB_ROOT_PASSWORD=cambia_esta_clave_root

# --- Puertos publicados en tu máquina (docker-compose) ---
BACKEND_PORT=8080
FRONTEND_PORT=80

# --- Backend / App ---
JWT_SECRET=cambia_esta_clave_jwt_larga_y_secreta_al_menos_32_caracteres
JWT_EXPIRATION=86400000
DDL_AUTO=update
SHOW_SQL=false

# --- Frontend build (proxy Nginx -> backend /api) ---
VITE_API_URL=/api
